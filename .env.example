# Backbone API (see docs/backend-arch-docs). Server-side only: never prefix these with NEXT_PUBLIC_.
BACKBONE_URL=
# The db_query_api_key configured on the Backbone server.
BACKBONE_DB_QUERY_API_KEY=
# Table names, if Backbone ever renames them. These are the documented defaults.
BACKBONE_STATIC_TABLE=media_list
BACKBONE_DYNAMIC_TABLE=user_media

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=<secret-here-paste>



